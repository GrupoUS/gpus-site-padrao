---
interface Props {
	title: string;
	subtitle?: string;
	align?: "left" | "center" | "right";
	light?: boolean;
}

const { title, subtitle, align = "center", light = true } = Astro.props;

const alignClasses: Record<string, string> = {
	left: "text-left",
	center: "text-center",
	right: "text-right",
};

const subtitleAlignClasses: Record<string, string> = {
	left: "mr-auto",
	center: "mx-auto",
	right: "ml-auto",
};

const accentAlignClasses: Record<string, string> = {
	left: "mr-auto",
	center: "mx-auto",
	right: "ml-auto",
};

const titleColor = light ? "text-gold" : "text-navy";
---

<div class={alignClasses[align]} data-reveal="up">
	<h2
		class:list={[
			"font-serif text-3xl md:text-4xl lg:text-5xl font-bold",
			titleColor,
		]}
	>
		{title}
	</h2>

	<div
		class:list={[
			"mt-4 h-0.5 w-15 bg-gold",
			accentAlignClasses[align],
		]}
		aria-hidden="true"
	></div>

	{
		subtitle && (
			<p
				class:list={[
					"text-text-muted text-lg md:text-xl mt-4 max-w-2xl",
					subtitleAlignClasses[align],
				]}
			>
				{subtitle}
			</p>
		)
	}
</div>
