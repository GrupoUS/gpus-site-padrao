---
interface Props {
	story: {
		headline: string;
		paragraphs: string[];
		highlight: string;
	};
	image?: string;
}

const { story, image = "/images/sacha-hero.webp" } = Astro.props;
---

<section class="bg-text-primary px-4 py-20 sm:px-6 lg:px-8">
	<div class="mx-auto max-w-7xl">
		<div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
			<!-- Image -->
			<div class="relative" data-reveal="left">
				<div class="overflow-hidden rounded-2xl">
					<img
						src={image}
						alt="Dra. Sacha Gualberto, mentora da Mentoria Black NEON e CEO do Grupo US"
						width="800"
						height="1000"
						class="h-auto w-full object-cover"
						loading="lazy"
						decoding="async"
						fetchpriority="low"
					/>
				</div>
				<!-- Decorative gold accent -->
				<div class="absolute -right-4 -bottom-4 -z-10 h-full w-full rounded-2xl border-2 border-gold/30" aria-hidden="true"></div>
			</div>

			<!-- Text content -->
			<div data-reveal="right">
				<h2 class="font-serif text-3xl font-bold leading-tight text-navy md:text-4xl">
					{story.headline}
				</h2>

				<div class="mt-8 space-y-5">
					{story.paragraphs.map((p) => (
						<p class="text-lg leading-relaxed text-navy-lighter">
							{p}
						</p>
					))}
				</div>

				<blockquote class="mt-8 border-l-4 border-gold pl-6">
					<p class="font-serif text-lg leading-relaxed font-medium text-navy italic">
						{story.highlight}
					</p>
				</blockquote>
			</div>
		</div>
	</div>
</section>
