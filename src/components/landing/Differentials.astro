---
import SectionHeading from "../shared/SectionHeading.astro";

interface Props {
	differentials: Array<{
		title: string;
		description: string;
	}>;
}

const { differentials } = Astro.props;
---

<section class="px-4 py-20 sm:px-6 lg:px-8">
	<div class="mx-auto max-w-7xl">
		<SectionHeading
			title="Diferenciais"
			subtitle="O que nos torna únicos"
		/>

		<div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2">
			{differentials.map((diff, index) => (
				<div
					class="glass-card rounded-2xl border-l-4 border-l-gold p-6 md:p-8 transition-all duration-300 hover:border-l-gold-light hover:bg-navy-light/50 hover:shadow-lg hover:shadow-gold/5"
					data-reveal="right"
					data-reveal-delay={String(index + 1)}
				>
					<h3 class="text-lg font-semibold text-gold">
						{diff.title}
					</h3>
					<p class="mt-3 leading-relaxed text-text-muted">
						{diff.description}
					</p>
				</div>
			))}
		</div>
	</div>
</section>
