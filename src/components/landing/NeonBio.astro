---
interface Props {
	bio: {
		name: string;
		title: string;
		photo: string;
		paragraphs: string[];
	};
}

const { bio } = Astro.props;
---

<section class="bg-text-primary px-4 py-20 sm:px-6 lg:px-8">
	<div class="mx-auto max-w-7xl">
		<div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-5">
			<!-- Photo column -->
			<div class="lg:col-span-2" data-reveal="left">
				<div class="relative mx-auto max-w-sm">
					<div class="overflow-hidden rounded-2xl">
						<img
							src={bio.photo}
							alt={`Retrato de ${bio.name}`}
							width="600"
							height="750"
							class="h-auto w-full object-cover"
							loading="lazy"
							decoding="async"
						/>
					</div>
					<!-- Gold corner accent -->
					<div class="absolute -right-3 -bottom-3 -z-10 h-full w-full rounded-2xl bg-gold/10" aria-hidden="true"></div>
				</div>
			</div>

			<!-- Bio text column -->
			<div class="lg:col-span-3" data-reveal="right">
				<span class="text-sm font-medium uppercase tracking-widest text-gold-dark">
					Quem é sua mentora
				</span>

				<h2 class="mt-3 font-serif text-3xl font-bold text-navy md:text-4xl">
					{bio.name}
				</h2>

				<p class="mt-1 text-lg font-medium text-navy-lighter">
					{bio.title}
				</p>

				<div class="mt-6 space-y-4">
					{bio.paragraphs.map((p) => (
						<p class="text-base leading-relaxed text-navy-lighter">
							{p}
						</p>
					))}
				</div>

				<!-- Authority badges -->
				<div class="mt-8 flex flex-wrap gap-3">
					<span class="rounded-full border border-gold-dark/30 bg-gold/10 px-4 py-1.5 text-sm font-medium text-gold-dark">
						13+ anos de experiência
					</span>
					<span class="rounded-full border border-gold-dark/30 bg-gold/10 px-4 py-1.5 text-sm font-medium text-gold-dark">
						Harvard &amp; Xiamen
					</span>
					<span class="rounded-full border border-gold-dark/30 bg-gold/10 px-4 py-1.5 text-sm font-medium text-gold-dark">
						Centenas de mentorados
					</span>
				</div>
			</div>
		</div>
	</div>
</section>
