---
import SectionHeading from "../shared/SectionHeading.astro";

interface Props {
	deliverables: Array<{ title: string; description: string }>;
}

const { deliverables } = Astro.props;
---

<section class="px-4 py-20 sm:px-6 lg:px-8">
	<div class="mx-auto max-w-7xl">
		<SectionHeading
			title="O que você recebe no NEON"
			subtitle="Uma jornada de aceleração com acompanhamento de alto nível e estratégias práticas"
		/>

		<div class="mt-14 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
			{deliverables.map((item, index) => (
				<div
					class="group rounded-2xl border border-gold/10 bg-navy-light/60 p-6 backdrop-blur-sm transition-all duration-300 hover:border-gold/25 hover:shadow-[0_0_20px_hsl(39_44%_65%/0.08)]"
					data-reveal="up"
					data-reveal-delay={String((index % 3) + 1)}
				>
					<div class="mb-2 flex items-center gap-3">
						<span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-gold/10 text-xs font-bold text-gold">
							{String(index + 1).padStart(2, "0")}
						</span>
						<h3 class="font-serif text-base font-bold text-gold">
							{item.title}
						</h3>
					</div>
					<p class="text-sm leading-relaxed text-text-muted">
						{item.description}
					</p>
				</div>
			))}
		</div>
	</div>
</section>
