---
import SectionHeading from "../shared/SectionHeading.astro";

interface Props {
	pillars: Array<{
		icon: string;
		title: string;
		description: string;
	}>;
}

const { pillars } = Astro.props;
---

<section class="px-4 py-20 sm:px-6 lg:px-8">
	<div class="mx-auto max-w-7xl">
		<SectionHeading
			title="O que você vai aprender"
			subtitle="Pilares do programa"
		/>

		<div class="mt-14 grid grid-cols-1 gap-6 lg:grid-cols-3">
			{pillars.map((pillar, index) => (
				<div
					class="glass-card rounded-2xl border-t-2 border-t-gold p-6 md:p-8 hover:border-gold/40 hover:shadow-lg hover:shadow-gold/5 transition-all duration-300 hover:bg-navy-light/30"
					data-reveal="scale"
					data-reveal-delay={String(index + 1)}
				>
					<!-- Numbered badge -->
					<span class="inline-block font-serif text-5xl font-bold text-gold">
						{String(index + 1).padStart(2, "0")}
					</span>

					<h3 class="mt-4 font-serif text-xl font-semibold text-gold">
						{pillar.title}
					</h3>
					<p class="mt-3 leading-relaxed text-text-muted">
						{pillar.description}
					</p>
				</div>
			))}
		</div>
	</div>
</section>
