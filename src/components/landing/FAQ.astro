---
import SectionHeading from "../shared/SectionHeading.astro";

interface Props {
	faqs: Array<{
		question: string;
		answer: string;
	}>;
}

const { faqs } = Astro.props;
---

<section class="px-4 py-20 sm:px-6 lg:px-8">
	<div class="mx-auto max-w-3xl">
		<SectionHeading title="Perguntas frequentes" />

		<div class="mt-14 space-y-3" data-reveal="up">
			{faqs.map((faq) => (
				<details class="group glass-card rounded-2xl transition-all duration-300 open:bg-navy-light/80 open:border-gold/30 open:shadow-lg open:shadow-gold/5 open:border-l-2 open:border-l-gold">
					<summary class="flex cursor-pointer list-none items-center justify-between p-6 font-semibold text-text-primary [&::-webkit-details-marker]:hidden hover:text-gold transition-colors duration-200">
						<span>{faq.question}</span>
						<svg
							class="ml-4 h-5 w-5 shrink-0 text-gold transition-transform duration-300 group-open:rotate-180"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="m6 9 6 6 6-6" />
						</svg>
					</summary>
					<div class="px-6 pb-6 pt-0 leading-relaxed text-text-muted">
						{faq.answer}
					</div>
				</details>
			))}
		</div>
	</div>
</section>
