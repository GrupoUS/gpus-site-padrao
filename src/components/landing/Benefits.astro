---
import SectionHeading from "../shared/SectionHeading.astro";

interface Props {
	benefits: string[];
}

const { benefits } = Astro.props;
---

<section class="px-4 py-20 sm:px-6 lg:px-8">
	<div class="mx-auto max-w-7xl">
		<SectionHeading
			title="Sua transformação"
			subtitle="O que muda na sua vida profissional"
			align="left"
		/>

		<div class="mt-14 grid grid-cols-1 items-start gap-12 lg:grid-cols-2">
			<!-- Benefits list -->
			<ul class="space-y-5" role="list">
				{benefits.map((benefit, index) => (
					<li
						class="flex items-start gap-4"
						data-reveal="left"
						data-reveal-delay={String(index + 1)}
					>
						<!-- Gold checkmark -->
						<span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center">
							<svg
								class="h-5 w-5 text-gold"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2.5"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="M20 6 9 17l-5-5" />
							</svg>
						</span>
						<span class="text-lg text-text-primary">{benefit}</span>
					</li>
				))}
			</ul>

			<!-- Decorative right side -->
			<div class="relative hidden lg:block" aria-hidden="true" data-reveal="scale">
				<div class="absolute top-8 right-8 h-64 w-64 rounded-full bg-gold/8 blur-[80px]"></div>
				<div class="absolute bottom-8 left-8 h-48 w-48 rounded-full bg-gold/5 blur-[60px]"></div>
				<div class="relative flex h-80 items-center justify-center">
					<div class="h-48 w-48 rounded-2xl border border-gold/15 bg-gold/5"></div>
					<div class="absolute h-36 w-36 translate-x-6 translate-y-6 rounded-2xl border border-gold/10 bg-gold/3"></div>
					<div class="absolute h-24 w-24 -translate-x-4 translate-y-12 rounded-2xl border border-gold/20 bg-gold/8"></div>
				</div>
			</div>
		</div>
	</div>
</section>
