---
import type { ProductNavLink } from "../../lib/productsNav";
import Logo from "../shared/Logo.astro";

interface Props {
	activeNav?: string;
	productNavLinks: ProductNavLink[];
}

const { activeNav, productNavLinks } = Astro.props;

const navLinks = [
	{ label: "Home", href: "/", id: "home" },
	{ label: "Sobre", href: "/sobre", id: "sobre" },
	{ label: "Contato", href: "/contato", id: "contato" },
];
---

<header
	class="fixed top-0 right-0 left-0 z-50 border-b border-gold/10 bg-navy/90 backdrop-blur-md transition-colors duration-300"
	id="site-header"
>
	<div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
		<!-- Logo -->
		<a
			href="/"
			class="group flex items-center gap-2 transition-opacity duration-200 hover:opacity-90"
			aria-label="Grupo US - Página inicial"
		>
			<Logo />
		</a>

		<!-- Desktop Navigation -->
		<nav class="hidden items-center gap-1 lg:flex" aria-label="Navegação principal">
			{navLinks.map((link) => (
				<a
					href={link.href}
					class:list={[
						"relative px-4 py-2 text-sm font-medium tracking-wide transition-colors duration-200",
						activeNav === link.id
							? "text-gold after:absolute after:bottom-0 after:left-4 after:right-4 after:h-0.5 after:bg-gold after:content-['']"
							: "text-text-muted hover:text-text-primary",
					]}
					aria-current={activeNav === link.id ? "page" : undefined}
				>
					{link.label}
				</a>
			))}

			<!-- Products Dropdown -->
			<div class="group relative">
				<button
					type="button"
					class:list={[
						"flex items-center gap-1 px-4 py-2 text-sm font-medium tracking-wide transition-colors duration-200",
						activeNav === "produtos"
							? "text-gold"
							: "text-text-muted hover:text-text-primary",
					]}
					aria-expanded="false"
					aria-haspopup="true"
					id="produtos-desktop-trigger"
				>
					Produtos
					<!-- Chevron Down -->
					<svg
						class="h-4 w-4 transition-transform duration-200 group-hover:rotate-180"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="m6 9 6 6 6-6" />
					</svg>
				</button>

				<!-- Dropdown Panel -->
				<div
					class="pointer-events-none absolute top-full left-0 z-50 min-w-[220px] translate-y-1 rounded-md border border-gold/15 bg-navy-light opacity-0 shadow-xl shadow-navy/50 transition-all duration-200 group-hover:pointer-events-auto group-hover:translate-y-0 group-hover:opacity-100"
					role="menu"
					id="produtos-desktop-menu"
				>
					<div class="py-2">
						{productNavLinks.map((product) => (
							<a
								href={product.href}
								class="block px-4 py-2.5 text-sm text-text-muted transition-colors duration-150 hover:bg-navy-lighter/50 hover:text-gold"
								role="menuitem"
								target={product.external ? "_blank" : undefined}
								rel={product.external ? "noopener noreferrer" : undefined}
							>
								{product.label}
							</a>
						))}
					</div>
				</div>
			</div>

			<!-- CTA -->
			<a
				href="/contato"
				class="ml-4 rounded-sm bg-gold px-5 py-2 text-sm font-semibold text-navy transition-all duration-200 hover:bg-gold-light hover:shadow-lg hover:shadow-gold/20"
			>
				Fale Conosco
			</a>
		</nav>

		<!-- Mobile Hamburger -->
		<button
			type="button"
			class="flex h-10 w-10 items-center justify-center rounded-sm text-text-muted transition-colors duration-200 hover:text-gold lg:hidden"
			aria-label="Abrir menu de navegação"
			aria-expanded="false"
			aria-controls="mobile-menu"
			id="hamburger-btn"
		>
			<!-- Menu icon (3 lines) -->
			<svg
				class="hamburger-icon h-6 w-6"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<line x1="4" x2="20" y1="6" y2="6" />
				<line x1="4" x2="20" y1="12" y2="12" />
				<line x1="4" x2="20" y1="18" y2="18" />
			</svg>
			<!-- X icon (close) -->
			<svg
				class="close-icon hidden h-6 w-6"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M18 6 6 18" />
				<path d="m6 6 12 12" />
			</svg>
		</button>
	</div>

	<!-- Mobile Menu Overlay -->
	<div
		class="fixed inset-0 top-0 z-40 flex -translate-y-full flex-col bg-navy/98 opacity-0 backdrop-blur-lg transition-[transform,opacity,visibility] duration-300 ease-out invisible pointer-events-none lg:hidden"
		id="mobile-menu"
		aria-label="Menu de navegação mobile"
		role="dialog"
		aria-modal="true"
	>
		<!-- Mobile menu header (mirrors main header for continuity) -->
		<div class="flex items-center justify-between border-b border-gold/10 px-4 py-3 sm:px-6">
			<a href="/" class="inline-flex" aria-label="Grupo US - Página inicial">
				<Logo />
			</a>
			<button
				type="button"
				class="flex h-10 w-10 items-center justify-center rounded-sm text-text-muted transition-colors duration-200 hover:text-gold"
				aria-label="Fechar menu de navegação"
				id="mobile-close-btn"
			>
				<svg
					class="h-6 w-6"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M18 6 6 18" />
					<path d="m6 6 12 12" />
				</svg>
			</button>
		</div>

		<!-- Mobile nav links -->
		<nav class="flex flex-1 flex-col gap-1 overflow-y-auto px-4 py-6 sm:px-6" aria-label="Navegação mobile">
			{navLinks.map((link) => (
				<a
					href={link.href}
					class:list={[
						"rounded-sm px-4 py-3 text-lg font-medium tracking-wide transition-colors duration-200",
						activeNav === link.id
							? "bg-navy-light text-gold"
							: "text-text-muted hover:bg-navy-light/50 hover:text-text-primary",
					]}
					aria-current={activeNav === link.id ? "page" : undefined}
				>
					{link.label}
				</a>
			))}

			<!-- Mobile Products Accordion -->
			<div class="mt-1">
				<button
					type="button"
					class:list={[
						"flex w-full items-center justify-between rounded-sm px-4 py-3 text-lg font-medium tracking-wide transition-colors duration-200",
						activeNav === "produtos"
							? "bg-navy-light text-gold"
							: "text-text-muted hover:bg-navy-light/50 hover:text-text-primary",
					]}
					aria-expanded="false"
					aria-controls="mobile-products-list"
					id="mobile-products-toggle"
				>
					Produtos
					<svg
						class="h-5 w-5 transition-transform duration-200"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
						id="mobile-products-chevron"
					>
						<path d="m6 9 6 6 6-6" />
					</svg>
				</button>

				<div class="hidden flex-col gap-0.5 pl-4 pt-1" id="mobile-products-list" role="list">
					{productNavLinks.map((product) => (
						<a
							href={product.href}
							class="rounded-sm px-4 py-2.5 text-base text-text-muted transition-colors duration-150 hover:bg-navy-light/50 hover:text-gold"
							role="listitem"
							target={product.external ? "_blank" : undefined}
							rel={product.external ? "noopener noreferrer" : undefined}
						>
							{product.label}
						</a>
					))}
				</div>
			</div>

			<!-- Mobile CTA -->
			<a
				href="/contato"
				class="mt-6 rounded-sm bg-gold px-5 py-3 text-center text-base font-semibold text-navy transition-all duration-200 hover:bg-gold-light"
			>
				Fale Conosco
			</a>
		</nav>
	</div>
</header>

<!-- Spacer to offset fixed header -->
<div class="h-[60px]" aria-hidden="true"></div>

<script>
	function initHeader() {
		const hamburgerBtn = document.getElementById("hamburger-btn");
		const mobileCloseBtn = document.getElementById("mobile-close-btn");
		const mobileMenu = document.getElementById("mobile-menu");
		const mobileProductsToggle = document.getElementById("mobile-products-toggle");
		const mobileProductsList = document.getElementById("mobile-products-list");
		const mobileProductsChevron = document.getElementById("mobile-products-chevron");
		const hamburgerIcon = hamburgerBtn?.querySelector(".hamburger-icon");
		const closeIcon = hamburgerBtn?.querySelector(".close-icon");

		function openMenu() {
			if (!mobileMenu || !hamburgerBtn || !hamburgerIcon || !closeIcon) return;
			mobileMenu.classList.remove("-translate-y-full", "opacity-0", "invisible", "pointer-events-none");
			mobileMenu.classList.add("translate-y-0", "opacity-100", "visible", "pointer-events-auto");
			hamburgerBtn.setAttribute("aria-expanded", "true");
			hamburgerIcon.classList.add("hidden");
			closeIcon.classList.remove("hidden");
			document.body.style.overflow = "hidden";

			// Focus the close button inside the overlay
			mobileCloseBtn?.focus();
		}

		function closeMenu() {
			if (!mobileMenu || !hamburgerBtn || !hamburgerIcon || !closeIcon) return;
			mobileMenu.classList.add("-translate-y-full", "opacity-0", "pointer-events-none");
			mobileMenu.classList.remove("translate-y-0", "opacity-100", "pointer-events-auto");
			hamburgerBtn.setAttribute("aria-expanded", "false");
			hamburgerIcon.classList.remove("hidden");
			closeIcon.classList.add("hidden");
			document.body.style.overflow = "";
			// Delay invisible/visible swap to allow transition to complete
			setTimeout(() => {
				if (mobileMenu.classList.contains("-translate-y-full")) {
					mobileMenu.classList.add("invisible");
					mobileMenu.classList.remove("visible");
				}
			}, 300);

			// Return focus to hamburger
			hamburgerBtn.focus();
		}

		hamburgerBtn?.addEventListener("click", openMenu);
		mobileCloseBtn?.addEventListener("click", closeMenu);

		// Close on Escape key
		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape" && !mobileMenu?.classList.contains("-translate-y-full")) {
				closeMenu();
			}
		});

		// Mobile products accordion
		mobileProductsToggle?.addEventListener("click", () => {
			const isExpanded = mobileProductsToggle.getAttribute("aria-expanded") === "true";
			mobileProductsToggle.setAttribute("aria-expanded", String(!isExpanded));

			if (isExpanded) {
				mobileProductsList?.classList.add("hidden");
				mobileProductsList?.classList.remove("flex");
				mobileProductsChevron?.style.setProperty("transform", "rotate(0deg)");
			} else {
				mobileProductsList?.classList.remove("hidden");
				mobileProductsList?.classList.add("flex");
				mobileProductsChevron?.style.setProperty("transform", "rotate(180deg)");
			}
		});

		// Header scroll effect: add subtle border on scroll
		const header = document.getElementById("site-header");
		let ticking = false;

		function onScroll() {
			if (!ticking) {
				requestAnimationFrame(() => {
					if (!header) return;
					if (window.scrollY > 20) {
						header.classList.add("border-gold/20");
						header.classList.remove("border-gold/10");
					} else {
						header.classList.remove("border-gold/20");
						header.classList.add("border-gold/10");
					}
					ticking = false;
				});
				ticking = true;
			}
		}

		window.addEventListener("scroll", onScroll, { passive: true });
	}

	initHeader();
</script>
