---
import type { ProductNavLink } from "../../lib/productsNav";
import { whatsappUrlBase } from "../../lib/whatsapp";
import Logo from "../shared/Logo.astro";

interface Props {
	productNavLinks: ProductNavLink[];
}

const { productNavLinks } = Astro.props;

const currentYear = new Date().getFullYear();

const quickLinks = [
	{ label: "Home", href: "/" },
	{ label: "Sobre", href: "/sobre" },
	{ label: "Contato", href: "/contato" },
];

const legalLinks = [
	{ label: "Termos de Uso", href: "/termos" },
	{ label: "Política de Privacidade", href: "/politica-de-privacidade" },
];
---

<footer class="border-t border-gold/10 bg-navy" role="contentinfo">
	<!-- Main Footer Grid -->
	<div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
		<div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
			<!-- Column 1: Brand -->
			<div class="sm:col-span-2 lg:col-span-1">
				<a href="/" class="inline-flex" aria-label="Grupo US - Página inicial">
					<Logo />
				</a>
				<p class="mt-4 max-w-xs text-sm leading-relaxed text-text-muted">
					Formação, mentoria e comunidade em saúde estética avançada — da técnica
					à escala de negócio, com trilhas claras para cada etapa da carreira.
				</p>

				<!-- Social Icons -->
				<div class="mt-6 flex items-center gap-4">
					<!-- Instagram -->
					<a
						href="https://instagram.com/drasachagualberto"
						target="_blank"
						rel="noopener noreferrer"
						class="flex h-9 w-9 items-center justify-center rounded-sm border border-gold/20 text-text-muted transition-all duration-200 hover:border-gold/40 hover:text-gold"
						aria-label="Instagram de Dra. Sacha Gualberto (abre em nova aba)"
					>
						<svg
							class="h-4 w-4"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
							<path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
							<line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
						</svg>
					</a>

					<!-- WhatsApp -->
					<a
						href={whatsappUrlBase}
						target="_blank"
						rel="noopener noreferrer"
						class="flex h-9 w-9 items-center justify-center rounded-sm border border-gold/20 text-text-muted transition-all duration-200 hover:border-whatsapp/40 hover:text-whatsapp"
						aria-label="WhatsApp — falar com a Laura, SDR do Grupo US (abre em nova aba)"
					>
						<svg
							class="h-4 w-4"
							viewBox="0 0 24 24"
							fill="currentColor"
							aria-hidden="true"
						>
							<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
						</svg>
					</a>

					<!-- Email -->
					<a
						href="mailto:suporte@drasacha.com.br"
						class="flex h-9 w-9 items-center justify-center rounded-sm border border-gold/20 text-text-muted transition-all duration-200 hover:border-gold/40 hover:text-gold"
						aria-label="Enviar e-mail para suporte@drasacha.com.br"
					>
						<svg
							class="h-4 w-4"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<rect width="20" height="16" x="2" y="4" rx="2" />
							<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
						</svg>
					</a>
				</div>
			</div>

			<!-- Column 2: Links Rapidos -->
			<div>
				<h3 class="font-serif text-sm font-semibold tracking-widest text-gold uppercase">
					Links Rápidos
				</h3>
				<ul class="mt-4 flex flex-col gap-2.5" role="list">
					{quickLinks.map((link) => (
						<li>
							<a
								href={link.href}
								class="text-sm text-text-muted transition-colors duration-200 hover:text-text-primary"
							>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</div>

			<!-- Column 3: Produtos -->
			<div>
				<h3 class="font-serif text-sm font-semibold tracking-widest text-gold uppercase">
					Produtos
				</h3>
				<ul class="mt-4 flex flex-col gap-2.5" role="list">
					{productNavLinks.map((product) => (
						<li>
							<a
								href={product.href}
								class="text-sm text-text-muted transition-colors duration-200 hover:text-text-primary"
								target={product.external ? "_blank" : undefined}
								rel={product.external ? "noopener noreferrer" : undefined}
							>
								{product.label}
							</a>
						</li>
					))}
				</ul>
			</div>

			<!-- Column 4: Contato -->
			<div>
				<h3 class="font-serif text-sm font-semibold tracking-widest text-gold uppercase">
					Contato
				</h3>
				<ul class="mt-4 flex flex-col gap-3" role="list">
					<li>
						<a
							href="mailto:suporte@drasacha.com.br"
							class="flex items-center gap-2.5 text-sm text-text-muted transition-colors duration-200 hover:text-text-primary"
						>
							<svg
								class="h-4 w-4 shrink-0 text-gold/60"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<rect width="20" height="16" x="2" y="4" rx="2" />
								<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
							</svg>
							suporte@drasacha.com.br
						</a>
					</li>
					<li>
						<a
							href={whatsappUrlBase}
							target="_blank"
							rel="noopener noreferrer"
							class="flex items-center gap-2.5 text-sm text-text-muted transition-colors duration-200 hover:text-whatsapp"
						>
							<svg
								class="h-4 w-4 shrink-0 text-whatsapp/60"
								viewBox="0 0 24 24"
								fill="currentColor"
								aria-hidden="true"
							>
								<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
							</svg>
							+55 62 9470-5081
						</a>
					</li>
					<li>
						<a
							href="https://instagram.com/drasachagualberto"
							target="_blank"
							rel="noopener noreferrer"
							class="flex items-center gap-2.5 text-sm text-text-muted transition-colors duration-200 hover:text-text-primary"
						>
							<svg
								class="h-4 w-4 shrink-0 text-gold/60"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
								<path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
								<line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
							</svg>
							@drasachagualberto
						</a>
					</li>
				</ul>
			</div>
		</div>
	</div>

	<!-- Bottom Bar -->
	<div class="border-t border-gold/10">
		<div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 px-4 py-5 sm:flex-row sm:px-6 lg:px-8">
			<p class="text-xs text-text-muted">
				&copy; {currentYear} Grupo US. Todos os direitos reservados.
			</p>
			<nav class="flex items-center gap-6" aria-label="Links legais">
				{legalLinks.map((link) => (
					<a
						href={link.href}
						class="text-xs text-text-muted transition-colors duration-200 hover:text-text-primary"
					>
						{link.label}
					</a>
				))}
			</nav>
		</div>
	</div>
</footer>
