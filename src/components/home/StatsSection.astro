---
import { AnimatedStats } from "../ui/AnimatedStats";

const stats = [
	{ number: "+5.000", label: "Profissionais impactados" },
	{ number: "26", label: "Estados atendidos" },
	{ number: "10+", label: "Países alcançados" },
	{ number: "7", label: "Programas educacionais" },
];
---

<section class="px-4 py-24 sm:px-6 lg:py-32" aria-labelledby="stats-ecosystem-heading">
	<div class="mx-auto max-w-5xl">
		<h2
			id="stats-ecosystem-heading"
			class="sr-only"
		>
			Alcance do Grupo US em números
		</h2>
		<AnimatedStats
			client:visible
			stats={stats}
			className="glass-card rounded-2xl px-6 py-12 md:px-12 md:py-16"
		/>
	</div>
</section>
