---
import { getCollection } from "astro:content";
import Card from "../shared/Card.astro";
import SectionHeading from "../shared/SectionHeading.astro";

const products = (await getCollection("products")).sort(
	(a, b) => a.data.order - b.data.order,
);

const iconPaths: Record<string, string> = {
	GraduationCap:
		'<path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/>',
	Globe:
		'<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>',
	Briefcase:
		'<path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/>',
	Users:
		'<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
	Stethoscope:
		'<path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6 6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3"/><path d="M8 15v1a6 6 0 0 0 6 6 6 6 0 0 0 6-6v-4"/><circle cx="20" cy="10" r="2"/>',
	Calendar:
		'<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>',
	LayoutDashboard:
		'<rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="5" x="14" y="12" rx="1"/><rect width="7" height="9" x="3" y="16" rx="1"/>',
	Gauge:
		'<path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/><path d="M12 2v4"/><path d="m16.2 7.8 2.9-2.9"/><path d="M22 12h-4"/><path d="m19.1 16.2 2.9 2.9"/><path d="M12 18v4"/><path d="m7.8 16.2-2.9 2.9"/><path d="M6 12H2"/><path d="m7.8 7.8-2.9-2.9"/>',
};

const typeColors: Record<string, string> = {
	"Pós-graduação + Mentoria": "bg-gold/15 text-gold",
	"MBA Internacional": "bg-gold/15 text-gold",
	"Mentoria de Negócios": "bg-gold/15 text-gold",
	"Educação Continuada": "bg-gold/15 text-gold",
	"Curso Técnico": "bg-gold/15 text-gold",
	"Evento Presencial": "bg-gold/15 text-gold",
	"Programa de Execução": "bg-gold/15 text-gold",
};
---

<section id="produtos" class="px-4 py-24 sm:px-6 lg:py-32">
	<div class="mx-auto max-w-7xl">
		<SectionHeading
			title="Programas do ecossistema"
			subtitle="Da entrada técnica à mentoria de escala — cada card abre o destino oficial do programa (site institucional ou página do produto)."
		/>

		<div class="mt-16 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3" data-glow-grid>
			{products.map((product, index) => (
				<div data-reveal="up" data-reveal-delay={String(index + 1)} data-glow-card>
					<Card
						href={
							product.data.externalSiteUrl ?? `/${product.data.slug}`
						}
						external={Boolean(product.data.externalSiteUrl)}
						hoverable={true}
						class="flex h-full flex-col"
					>
						{/* Lucide icon */}
						<div class="mb-5 flex h-12 w-12 items-center justify-center rounded-sm border border-gold/20 bg-gradient-to-br from-gold/20 to-gold/5">
							<svg
								class="h-6 w-6 text-gold"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								set:html={iconPaths[product.data.icon] || ''}
							/>
						</div>

						{/* Product name */}
						<h3 class="font-serif text-xl font-bold text-gold">
							{product.data.name}
						</h3>

						{/* Tagline */}
						<p class="mt-2 flex-1 text-sm leading-relaxed text-text-muted">
							{product.data.tagline}
						</p>

						{/* Type badge */}
						<div class="mt-4">
							<span
								class:list={[
									"inline-block rounded-sm px-3 py-1 text-xs font-medium",
									typeColors[product.data.type] || "bg-gold/15 text-gold",
								]}
							>
								{product.data.type}
							</span>
						</div>

						{/* Link */}
						<span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-gold transition-colors duration-200 hover:text-gold-light">
							Ver programa
							<svg
								class="h-4 w-4 group-hover:translate-x-1 transition-transform duration-300"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="M5 12h14" />
								<path d="m12 5 7 7-7 7" />
							</svg>
						</span>
						{product.data.externalSiteUrl ? (
							<span class="sr-only">Abre o site do produto em nova aba</span>
						) : null}
					</Card>
				</div>
			))}
		</div>
	</div>
</section>

<script>
	function initGlowGrid() {
		const grid = document.querySelector("[data-glow-grid]");
		if (!grid || window.matchMedia("(pointer: coarse)").matches) return;

		grid.addEventListener("mousemove", (evt) => {
			const e = evt as MouseEvent;
			const cards = grid.querySelectorAll("[data-glow-card]");
			for (const card of cards) {
				const rect = card.getBoundingClientRect();
				(card as HTMLElement).style.setProperty(
					"--mouse-x",
					`${e.clientX - rect.left}px`,
				);
				(card as HTMLElement).style.setProperty(
					"--mouse-y",
					`${e.clientY - rect.top}px`,
				);
			}
		});
	}

	initGlowGrid();
</script>
