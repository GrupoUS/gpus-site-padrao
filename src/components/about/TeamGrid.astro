---
import { getCollection } from "astro:content";
import Card from "../shared/Card.astro";
import SectionHeading from "../shared/SectionHeading.astro";

const teamEntries = await getCollection("team");
const team = teamEntries
	.map((entry) => entry.data)
	.filter((m) => m.order > 2)
	.sort((a, b) => a.order - b.order);
---

<section class="py-20 px-4" aria-labelledby="equipe-heading">
	<div class="max-w-6xl mx-auto">
		<SectionHeading
			title="Nossa Equipe"
			subtitle="O time que faz o ecossistema acontecer"
		/>

		<div class="mt-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
			{team.map((member, index) => (
				<div data-reveal="scale" data-reveal-delay={String((index % 4) + 1)}>
					<Card hoverable class="h-full text-center">
						<div class="mb-4 flex justify-center">
							<img
								src={member.photo}
								alt={`Retrato de ${member.name}`}
								width={96}
								height={96}
								class="h-24 w-24 rounded-full border-2 border-gold/20 bg-navy-lighter object-cover"
								loading="lazy"
								decoding="async"
								fetchpriority="low"
							/>
						</div>

						<h3 class="font-serif text-lg font-semibold text-gold">
							{member.name}
						</h3>
						<p class="text-text-muted text-xs uppercase tracking-wider mt-1">
							{member.role}
						</p>
						<p class="text-text-muted text-sm mt-3 leading-relaxed">
							{member.bio}
						</p>

						{(member.social.instagram || member.social.linkedin) && (
							<div class="flex justify-center gap-3 mt-4">
								{member.social.instagram && (
									<a
										href={member.social.instagram}
										target="_blank"
										rel="noopener noreferrer"
										class="inline-flex items-center gap-1.5 text-gold/70 hover:text-gold transition-colors duration-200"
										aria-label={`Instagram de ${member.name}`}
									>
										<svg
											class="w-4 h-4"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
											aria-hidden="true"
										>
											<rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
											<path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
											<line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
										</svg>
										<span class="text-xs">Instagram</span>
									</a>
								)}
								{member.social.linkedin && (
									<a
										href={member.social.linkedin}
										target="_blank"
										rel="noopener noreferrer"
										class="inline-flex items-center gap-1.5 text-gold/70 hover:text-gold transition-colors duration-200"
										aria-label={`LinkedIn de ${member.name}`}
									>
										<svg
											class="w-4 h-4"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
											aria-hidden="true"
										>
											<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
											<rect width="4" height="12" x="2" y="9" />
											<circle cx="4" cy="4" r="2" />
										</svg>
										<span class="text-xs">LinkedIn</span>
									</a>
								)}
							</div>
						)}
					</Card>
				</div>
			))}
		</div>
	</div>
</section>
