---
import Card from "../shared/Card.astro";
import SectionHeading from "../shared/SectionHeading.astro";

const missions = [
	{
		title: "Propósito",
		description:
			"Transformar profissionais da saúde em referências, unindo técnica, gestão e comunidade. Transformamos conhecimento em performance, liderança e protagonismo.",
		icon: "target",
	},
	{
		title: "Missão",
		description:
			"Impactar o maior número de profissionais da saúde no mundo através da Saúde Estética. Despertamos brilho e potenciais adormecidos para formar líderes em suas vidas e negócios.",
		icon: "compass",
	},
	{
		title: "Visão",
		description:
			"Ser o ecossistema mais completo em Saúde e Negócios globalmente, com expansão internacional e protagonismo global.",
		icon: "eye",
	},
];

const vision = [
	{
		period: "Curto Prazo",
		timeframe: "0 a 12 meses",
		description:
			"Estruturar base sólida, cultura forte e crescimento previsível.",
	},
	{
		period: "Médio Prazo",
		timeframe: "1 a 3 anos",
		description: "Ser a principal referência nacional em formação estratégica.",
	},
	{
		period: "Longo Prazo",
		timeframe: "3 a 7 anos",
		description: "Expansão internacional e protagonismo global.",
	},
];
---

<section class="py-20 px-4" aria-labelledby="quem-somos-heading">
	<div class="max-w-6xl mx-auto">
		<SectionHeading
			title="Quem Somos"
			subtitle="Conheça o propósito por trás do Grupo US"
		/>

		<div class="mt-14 grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8">
			{missions.map((item, index) => (
				<div data-reveal="up" data-reveal-delay={String(index + 1)}>
					<Card class="h-full text-center">
						<div class="flex justify-center mb-5">
							<div class="w-14 h-14 rounded-xl bg-gold/10 flex items-center justify-center">
								{item.icon === "target" && (
									<svg
										class="w-7 h-7 text-gold"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
										aria-hidden="true"
									>
										<circle cx="12" cy="12" r="10" />
										<circle cx="12" cy="12" r="6" />
										<circle cx="12" cy="12" r="2" />
									</svg>
								)}
								{item.icon === "compass" && (
									<svg
										class="w-7 h-7 text-gold"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
										aria-hidden="true"
									>
										<circle cx="12" cy="12" r="10" />
										<polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" />
									</svg>
								)}
								{item.icon === "eye" && (
									<svg
										class="w-7 h-7 text-gold"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
										aria-hidden="true"
									>
										<path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" />
										<circle cx="12" cy="12" r="3" />
									</svg>
								)}
							</div>
						</div>
						<h3 class="font-serif text-xl font-semibold text-gold mb-3">
							{item.title}
						</h3>
						<p class="text-text-muted text-sm leading-relaxed">
							{item.description}
						</p>
					</Card>
				</div>
			))}
		</div>

		<!-- Roadmap de Visão -->
		<div class="mt-16" data-reveal="up">
			<h3 class="font-serif text-2xl font-bold text-text-primary text-center mb-8">
				Roadmap de <span class="text-gold">Crescimento</span>
			</h3>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
				{vision.map((step, index) => (
					<div
						class="glass-card rounded-2xl p-6 text-center relative overflow-hidden"
						data-reveal="up"
						data-reveal-delay={String(index + 1)}
					>
						<span class="text-gold/20 font-serif text-5xl font-bold absolute top-3 right-4">
							{String(index + 1)}
						</span>
						<p class="text-gold font-semibold text-sm uppercase tracking-wider mb-1">
							{step.period}
						</p>
						<p class="text-text-muted text-xs mb-3">
							{step.timeframe}
						</p>
						<p class="text-text-primary text-sm leading-relaxed">
							{step.description}
						</p>
					</div>
				))}
			</div>
		</div>
	</div>
</section>
