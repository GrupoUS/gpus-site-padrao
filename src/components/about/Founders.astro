---
import { getCollection } from "astro:content";
import SectionHeading from "../shared/SectionHeading.astro";

const teamEntries = await getCollection("team");
const founders = teamEntries
	.map((entry) => entry.data)
	.filter((m) => m.order <= 2)
	.sort((a, b) => a.order - b.order);
---

<section class="py-20 px-4" aria-labelledby="fundadores-heading">
	<div class="max-w-5xl mx-auto">
		<SectionHeading
			title="Fundadores"
			subtitle="Os sócios por trás do Grupo US"
		/>

		<div class="mt-14 grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
			{founders.map((founder, index) => (
				<div
					class="glass-card rounded-2xl p-8 flex flex-col items-center text-center"
					data-reveal="up"
					data-reveal-delay={String(index + 1)}
				>
					<img
						src={founder.photo}
						alt={`Retrato de ${founder.name}`}
						width={192}
						height={192}
						class="h-48 w-48 rounded-full border-2 border-gold/30 bg-navy-lighter object-cover mb-6"
						loading="lazy"
						decoding="async"
						fetchpriority="low"
					/>

					<h3 class="font-serif text-2xl font-bold text-gold">
						{founder.name}
					</h3>
					<p class="text-gold-light/70 text-sm uppercase tracking-wider mt-1">
						{founder.role}
					</p>
					<p class="text-text-muted text-base mt-4 leading-relaxed max-w-md">
						{founder.bio}
					</p>

					<div class="flex gap-3 mt-5">
						{founder.social.instagram && (
							<a
								href={founder.social.instagram}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center gap-2 text-gold/70 hover:text-gold transition-colors duration-200"
								aria-label={`Instagram de ${founder.name}`}
							>
								<svg
									class="w-5 h-5"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
									<path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
									<line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
								</svg>
								<span class="text-sm">Instagram</span>
							</a>
						)}
						{founder.social.linkedin && (
							<a
								href={founder.social.linkedin}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center gap-2 text-gold/70 hover:text-gold transition-colors duration-200"
								aria-label={`LinkedIn de ${founder.name}`}
							>
								<svg
									class="w-5 h-5"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
									<rect width="4" height="12" x="2" y="9" />
									<circle cx="4" cy="4" r="2" />
								</svg>
								<span class="text-sm">LinkedIn</span>
							</a>
						)}
					</div>
				</div>
			))}
		</div>
	</div>
</section>
