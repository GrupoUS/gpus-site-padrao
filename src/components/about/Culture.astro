---
import SectionHeading from "../shared/SectionHeading.astro";

const pillars = [
	{
		letter: "A",
		title: "Atitude de Dono",
		description: "Assumimos responsabilidades e trazemos soluções.",
	},
	{
		letter: "C",
		title: "Clareza e Verdade",
		description: "Comunicação direta, ética e objetiva.",
	},
	{
		letter: "T",
		title: "Trabalho Organizado",
		description: "Processos claros, disciplina e foco.",
	},
	{
		letter: "I",
		title: "Integração e Conexão",
		description: "Crescemos juntos e colaboramos estrategicamente.",
	},
	{
		letter: "V",
		title: "Valorização e Evolução",
		description: "Aprendizado constante e desenvolvimento contínuo.",
	},
	{
		letter: "A",
		title: "Alta Performance",
		description: "Compromisso com qualidade e resultado.",
	},
];
---

<section class="py-20 px-4" aria-labelledby="cultura-heading">
	<div class="max-w-5xl mx-auto">
		<SectionHeading
			title="Cultura A.C.T.I.V.A"
			subtitle="A cultura que praticamos no dia a dia"
		/>

		<div class="mt-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
			{pillars.map((pillar, index) => (
				<div
					class="glass-card rounded-2xl p-6 flex items-start gap-4 group"
					data-reveal="scale"
					data-reveal-delay={String((index % 3) + 1)}
				>
					<span class="flex-shrink-0 inline-flex items-center justify-center w-12 h-12 rounded-xl bg-gold/10 font-serif text-xl font-bold text-gold group-hover:bg-gold/20 transition-colors duration-200">
						{pillar.letter}
					</span>
					<div>
						<h3 class="font-semibold text-text-primary text-base mb-1">
							{pillar.title}
						</h3>
						<p class="text-text-muted text-sm leading-relaxed">
							{pillar.description}
						</p>
					</div>
				</div>
			))}
		</div>

		<p class="text-center text-text-muted text-sm mt-10 max-w-2xl mx-auto italic" data-reveal="up">
			"Cultura não é discurso. É prática."
		</p>
	</div>
</section>
