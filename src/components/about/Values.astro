---
import SectionHeading from "../shared/SectionHeading.astro";

const values = [
	{
		number: "01",
		title: "Transparência Radical",
		description:
			"Falamos o que precisa ser dito, no tempo certo e com respeito. Comunicação direta, transparente e sem rodeios.",
	},
	{
		number: "02",
		title: "Honestidade Inegociável",
		description:
			"Ética não é circunstancial, é padrão. Em cada decisão, em cada entrega, a integridade vem primeiro.",
	},
	{
		number: "03",
		title: "Empatia com Responsabilidade",
		description:
			"Entendemos o contexto sem abrir mão do resultado. Cuidar é também exigir o melhor de cada um.",
	},
	{
		number: "04",
		title: "Excelência com Entrega Real",
		description:
			"Não vendemos promessa vazia, entregamos transformação concreta. Cada ação é medida pelo impacto real na vida dos profissionais.",
	},
	{
		number: "05",
		title: "Autorresponsabilidade",
		description:
			"Errou? Assume. Aprende. Ajusta. Cada membro assume protagonismo sobre sua jornada — nós mudamos o cenário.",
	},
	{
		number: "06",
		title: "Simplicidade Eficaz",
		description:
			"Processos claros e decisões objetivas. Eliminamos o desnecessário para focar no que realmente transforma.",
	},
	{
		number: "07",
		title: "Evolução Contínua",
		description:
			"Crescimento técnico, pessoal e estratégico. Quem para de evoluir, para de liderar.",
	},
];
---

<section class="py-20 px-4" aria-labelledby="valores-heading">
	<div class="max-w-6xl mx-auto">
		<SectionHeading
			title="Nossos Valores"
			subtitle="Princípios que guiam cada decisão"
		/>

		<div class="mt-14 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
			{values.map((value, index) => (
				<div
					class:list={[
						"glass-card rounded-2xl p-6 md:p-8",
						index === 6 ? "md:col-start-1 lg:col-start-2" : "",
					]}
					data-reveal="up"
					data-reveal-delay={String((index % 3) + 1)}
				>
					<div class="flex items-start gap-4">
						<div class="flex-shrink-0">
							<span class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-gold/10 font-serif text-sm font-bold text-gold">
								{value.number}
							</span>
						</div>
						<div class="flex-1">
							<h3 class="font-semibold text-text-primary text-base mb-2">
								{value.title}
							</h3>
							<p class="text-text-muted text-sm leading-relaxed">
								{value.description}
							</p>
						</div>
					</div>
				</div>
			))}
		</div>
	</div>
</section>
